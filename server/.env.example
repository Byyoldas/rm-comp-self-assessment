# Optional. If unset, the app runs fully offline using the deterministic
# heuristic evidence evaluator instead of calling the Anthropic API.
ANTHROPIC_API_KEY=
RM_COMP_LLM_MODEL=claude-sonnet-5
PORT=4000

# Optional. Set this to enable the admin dashboard at /admin, which lists every
# completed submission on this server and lets you export them all at once.
# Pick any long random string and share it only with whoever should see everyone's
# results. Leave unset to keep the dashboard disabled.
ADMIN_TOKEN=
